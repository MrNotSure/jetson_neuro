#!/bin/zsh
# T6, 2 Nov 2026 (from the 31 Oct session's `b`): run ONE command on the board over the USB cable, logging it first.
# usage: b 'remote command'      (never used for sudo: those go as their own `ssh jetson-usb 'sudo ...'`)
LOG=/Users/<user>/Documents/code/jetson_neuro/runs/t6_20261102/commands.log
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
one=${1//$'\n'/ ⏎ }
printf '%s\tboard\tssh jetson-usb %s\n' "$ts" "$one" >> "$LOG"
exec ssh -o ConnectTimeout=5 jetson-usb "$1"
