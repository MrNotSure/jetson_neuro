#!/bin/zsh
# T6b, 2 Nov 2026 (from T6's `b`): run ONE command on the board over the USB cable, logging it first.
# usage: b 'remote command'      (sudo commands are logged with the same prefix, one per call)
LOG=/Users/<user>/Documents/code/jetson_neuro/runs/t6b_20261102/commands.log
ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
one=${1//$'\n'/ ⏎ }
printf '%s\tboard\tssh jetson-usb %s\n' "$ts" "$one" >> "$LOG"
exec ssh -o ConnectTimeout=5 jetson-usb "$1"
